#region --- Identity & Access Auditor ---
function Invoke-IdentityAudit($Log, [int]$StaleDays = 90) {
    $results = [System.Collections.Generic.List[PSCustomObject]]::new()

    if ($Global:IsSimulation) {
        Append-LogText $Log "  [SIMULATION MODE] Generating sample identity data...`r`n`r`n"
        Start-Sleep -Milliseconds 300
        $results.Add([PSCustomObject]@{Component="Local Administrators";  Status="OK";   Details="Secure count (1 user): [Administrator]";                Fix=$null})
        $results.Add([PSCustomObject]@{Component="Stale User Accounts";   Status="OK";   Details="All active accounts logged in recently";                Fix=$null})
        $results.Add([PSCustomObject]@{Component="Password Expiry";       Status="WARN"; Details="Accounts set to 'Password Never Expires': [devuser]";   Fix="Run: Set-LocalUser -Name devuser -PasswordNeverExpires `$false"})
        $results.Add([PSCustomObject]@{Component="Password Requirement";  Status="OK";   Details="All active accounts require a password";                Fix=$null})
        return $results
    }

    $localUsers = Get-LocalUser -ErrorAction SilentlyContinue

    # --- Local Admins ---
    try {
        $adminGroup = Get-LocalGroup | Where-Object { $_.SID -eq 'S-1-5-32-544' }
        if ($adminGroup) {
            $adminMembers = Get-LocalGroupMember -Group $adminGroup.Name -ErrorAction SilentlyContinue
            $memberNames  = ($adminMembers | Select-Object -ExpandProperty Name) -join ", "
            if ($adminMembers.Count -gt 2) {
                $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="WARN"; Details="High count ($($adminMembers.Count) users): [$memberNames]"; Fix="Review and remove unnecessary accounts from Administrators group."})
            } else {
                $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="OK"; Details="Secure count ($($adminMembers.Count) users): [$memberNames]"; Fix=$null})
            }
        } else {
            $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="FAIL"; Details="Unable to resolve Administrators group SID"; Fix="Verify SAM database integrity."})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="FAIL"; Details="Error: $($_.Exception.Message)"; Fix=$null})
    }

    # --- Stale Accounts ---
    try {
        $staleCutoff = (Get-Date).AddDays(-$StaleDays)
        $staleUsers  = $localUsers | Where-Object {
            $_.Enabled -eq $true -and
            (($_.LastLogon -lt $staleCutoff) -or ($null -eq $_.LastLogon)) -and
            $_.Name -notmatch "Administrator|Guest|DefaultAccount"
        }
        if ($staleUsers) {
            $staleNames = ($staleUsers | Select-Object -ExpandProperty Name) -join ", "
            $results.Add([PSCustomObject]@{Component="Stale User Accounts"; Status="WARN"; Details="Inactive for >$StaleDays days: [$staleNames]"; Fix="Disable or delete inactive accounts to reduce attack surface."})
        } else {
            $results.Add([PSCustomObject]@{Component="Stale User Accounts"; Status="OK"; Details="All active accounts logged in within $StaleDays days"; Fix=$null})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Stale User Accounts"; Status="FAIL"; Details="Error: $($_.Exception.Message)"; Fix=$null})
    }

    # --- Password Never Expires ---
    try {
        $pneUsers = $localUsers | Where-Object {
            $_.Enabled -eq $true -and
            $_.PasswordNeverExpires -eq $true -and
            $_.Name -notmatch "Administrator|Guest|DefaultAccount"
        }
        if ($pneUsers) {
            $pneNames = ($pneUsers | Select-Object -ExpandProperty Name) -join ", "
            $results.Add([PSCustomObject]@{Component="Password Expiry"; Status="WARN"; Details="'Password Never Expires' set on: [$pneNames]"; Fix="Run: Set-LocalUser -Name <User> -PasswordNeverExpires `$false"})
        } else {
            $results.Add([PSCustomObject]@{Component="Password Expiry"; Status="OK"; Details="All accounts comply with rotation baselines"; Fix=$null})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Password Expiry"; Status="FAIL"; Details="Error: $($_.Exception.Message)"; Fix=$null})
    }

    # --- Password Required ---
    try {
        $noPassUsers = $localUsers | Where-Object {
            $_.Enabled -eq $true -and
            $_.PasswordRequired -eq $false -and
            $_.Name -notmatch "Guest|DefaultAccount"
        }
        if ($noPassUsers) {
            $noPassNames = ($noPassUsers | Select-Object -ExpandProperty Name) -join ", "
            $results.Add([PSCustomObject]@{Component="Password Requirement"; Status="FAIL"; Details="Accounts without password required: [$noPassNames]"; Fix="Run: Set-LocalUser -Name <User> -PasswordRequired `$true"})
        } else {
            $results.Add([PSCustomObject]@{Component="Password Requirement"; Status="OK"; Details="All active accounts require a password"; Fix=$null})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Password Requirement"; Status="FAIL"; Details="Error: $($_.Exception.Message)"; Fix=$null})
    }

    return $results
}

function Show-IdentityAuditWindow {
    $Log = New-LogWindow "Identity & Access Auditor"
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "                  IDENTITY & ACCESS AUDITOR`r`n"
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "  Host: $($env:COMPUTERNAME)  |  Scope: Local SAM Database`r`n"
    Append-LogText $Log "  Mode: $(if ($Global:IsSimulation) { 'SIMULATION (Dry Run)' } else { 'LIVE SCAN' })  |  Stale threshold: 90 days`r`n"
    Append-LogText $Log "───────────────────────────────────────────────────────────────`r`n`r`n"
    Append-LogText $Log "Running identity audit, please wait...`r`n`r`n"

    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $results = Invoke-IdentityAudit $Log 90

    foreach ($res in $results) {
        Write-DiagRow $Log $res.Component $res.Status $res.Details $res.Fix
    }

    $sw.Stop()
    Write-DiagSummary $Log $results ([math]::Round($sw.Elapsed.TotalSeconds, 1))
}
#endregion

#region --- Cyber Incident Sniffer ---
function Invoke-IncidentSniffer($Log, [int]$HoursFilter = 48) {
    $results = [System.Collections.Generic.List[PSCustomObject]]::new()

    if ($Global:IsSimulation) {
        Append-LogText $Log "  [SIMULATION MODE] Generating sample incident data...`r`n`r`n"
        Start-Sleep -Milliseconds 300
        $results.Add([PSCustomObject]@{Component="Failed Logons";  Status="WARN"; Details="3 failed logon attempts detected (simulated)"; Fix="Review accounts. Consider account lockout policy."})
        $results.Add([PSCustomObject]@{Component="Log Clearing";   Status="OK";   Details="No log clearing activities detected"; Fix=""})
        $results.Add([PSCustomObject]@{Component="USB Storage";    Status="WARN"; Details="2 USB insertion events in last 48h (simulated)"; Fix="Verify USB devices were authorized."})
        return $results
    }

    $timeFilter = (Get-Date).AddHours(-$HoursFilter)

    # --- Failed Logons (Event 4625) ---
    try {
        [array]$failedLogons = Get-WinEvent -FilterHashtable @{LogName="Security"; Id=4625; StartTime=$timeFilter} -ErrorAction SilentlyContinue
        
        if ($failedLogons.Count -gt 0) {
            $uniqueUsers = @{}
            foreach ($ev in $failedLogons) {
                try {
                    [xml]$xml = $ev.ToXml()
                    $targetNode = $xml.Event.EventData.Data | Where-Object { $_.Name -eq "TargetUserName" }
                    $ipNode     = $xml.Event.EventData.Data | Where-Object { $_.Name -eq "IpAddress" }
                    $user = if ($targetNode) { $targetNode.'#text' } else { "Unknown" }
                    $ip   = if ($ipNode)     { $ipNode.'#text'     } else { "-" }
                    if ($user) { $uniqueUsers[$user] = $ip }
                } catch { }
            }
            $userList = ($uniqueUsers.Keys | Select-Object -First 5) -join ", "
            $results.Add([PSCustomObject]@{Component="Failed Logons"; Status="WARN"; Details="$($failedLogons.Count) failed attempts on: [$userList]"; Fix="Consider account lockout policy or investigate source IPs."})

            # Show last 5 events in detail
            Append-LogText $Log "  Recent failed logon events (last 5):`r`n"
            $failedLogons | Select-Object -First 5 | ForEach-Object {
                try {
                    [xml]$xml = $_.ToXml()
                    $targetNode = $xml.Event.EventData.Data | Where-Object { $_.Name -eq "TargetUserName" }
                    $ipNode     = $xml.Event.EventData.Data | Where-Object { $_.Name -eq "IpAddress" }
                    $user = if ($targetNode) { $targetNode.'#text' } else { "Unknown" }
                    $ip   = if ($ipNode)     { $ipNode.'#text'     } else { "-" }
                    if (-not $ip -or $ip -eq "-") { $ip = "Local/Physical" }
                    Append-LogText $Log "    $($_.TimeCreated.ToString('yyyy-MM-dd HH:mm'))  User: $($user.PadRight(20)) IP: $ip`r`n"
                } catch { }
            }
            Append-LogText $Log "`r`n"
        } else {
            $results.Add([PSCustomObject]@{Component="Failed Logons"; Status="OK"; Details="No failed logon attempts in last $HoursFilter hours"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Failed Logons"; Status="FAIL"; Details="Cannot query Security log: $($_.Exception.Message)"; Fix="Ensure Security audit logging is enabled."})
    }

    # --- Log Clearing (Events 1102, 104) ---
    try {
        [array]$clearEvents = Get-WinEvent -FilterHashtable @{LogName=@("Security","System"); Id=@(1102,104); StartTime=$timeFilter} -ErrorAction SilentlyContinue
        if ($clearEvents.Count -gt 0) {
            $clearList = ($clearEvents | ForEach-Object { "$($_.LogName) @ $($_.TimeCreated.ToString('HH:mm'))" }) -join ", "
            $results.Add([PSCustomObject]@{Component="Log Clearing"; Status="FAIL"; Details="CRITICAL: Audit logs were explicitly cleared! [$clearList]"; Fix="Investigate immediately — log clearing is a common attacker cover-up."})
        } else {
            $results.Add([PSCustomObject]@{Component="Log Clearing"; Status="OK"; Details="No log clearing activities detected"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Log Clearing"; Status="FAIL"; Details="Cannot query log clearance events"; Fix="Check event log service and permissions."})
    }

    # --- USB / Removable Storage (Event 411) ---
    try {
        [array]$usbEvents = Get-WinEvent -FilterHashtable @{LogName="System"; ProviderName="Microsoft-Windows-Kernel-PnP"; Id=411; StartTime=$timeFilter} -ErrorAction SilentlyContinue
        if ($usbEvents.Count -gt 0) {
            $results.Add([PSCustomObject]@{Component="USB Storage"; Status="WARN"; Details="$($usbEvents.Count) hardware insertion events detected"; Fix="Verify each USB device was authorized for this system."})
            Append-LogText $Log "  Recent device insertion events:`r`n"
            $usbEvents | Select-Object -First 5 | ForEach-Object {
                $devLine = ($_.Message -split "`r`n" | Where-Object { $_ -match "Device" } | Select-Object -First 1)
                if (-not $devLine) { $devLine = $_.Message.Trim() }
                if ($devLine.Length -gt 80) { $devLine = $devLine.Substring(0,80) + "..." }
                Append-LogText $Log "    $($_.TimeCreated.ToString('yyyy-MM-dd HH:mm'))  $devLine`r`n"
            }
            Append-LogText $Log "`r`n"
        } else {
            $results.Add([PSCustomObject]@{Component="USB Storage"; Status="OK"; Details="No external USB storage insertion events detected"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="USB Storage"; Status="FAIL"; Details="Cannot query PnP hardware events"; Fix="Check Kernel-PnP event provider is active."})
    }

    return $results
}

