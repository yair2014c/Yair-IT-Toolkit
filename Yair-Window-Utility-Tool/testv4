#region --- System Diagnostic ---
function Invoke-SystemDiagnostic($Log) {
    $results = [System.Collections.Generic.List[PSCustomObject]]::new()

    if ($Global:IsSimulation) {
        Append-LogText $Log "  [SIMULATION MODE] Generating sample data...`r`n`r`n"
        Start-Sleep -Milliseconds 300
        $results.Add([PSCustomObject]@{Component="Storage (C:)";     Status="OK";   Details="Healthy (67% free)";                           Fix=""})
        $results.Add([PSCustomObject]@{Component="Storage (D:)";     Status="WARN"; Details="Low space (8% free)";                          Fix="Clean temp files or move data to another drive."})
        $results.Add([PSCustomObject]@{Component="Disk SMART";       Status="OK";   Details="Drive health is normal";                       Fix=""})
        $results.Add([PSCustomObject]@{Component="Windows Defender"; Status="OK";   Details="Protection active | Signatures: 1 day old";    Fix=""})
        $results.Add([PSCustomObject]@{Component="System Services";  Status="OK";   Details="All critical automatic services running";      Fix=""})
        $results.Add([PSCustomObject]@{Component="System Stability"; Status="OK";   Details="No critical crashes in last 48h";              Fix=""})
        $results.Add([PSCustomObject]@{Component="Network (Ethernet)";Status="OK";  Details="Connected (1 Gbps) | IP: 192.168.1.100";       Fix=""})
        $results.Add([PSCustomObject]@{Component="Internet Access";  Status="OK";   Details="Online (Ping: 14ms, DNS: OK)";                 Fix=""})
    } else {
        # --- Hardware Summary ---
        try {
            $os = Get-CimInstance Win32_OperatingSystem
            $cs = Get-CimInstance Win32_ComputerSystem
            $chassisType = switch ($cs.PCSystemType) {
                1 { "Desktop" } 2 { "Laptop" } 3 { "Workstation" }
                4 { "Enterprise Server" } default { "Virtual Machine / Unknown" }
            }
            $cleanVendor = ($cs.Manufacturer -replace " COMPUTER INC\.| Inc\.| Corporation| Ltd\.", "").Trim()
            if ($cleanVendor -match "ASUSTeK") { $cleanVendor = "ASUS" }
            $cpuLoad       = (Get-CimInstance Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average
            $ramGb         = [math]::Round($cs.TotalPhysicalMemory / 1GB, 2)
            $ramUsedPct    = [math]::Round((($os.TotalVisibleMemorySize - $os.FreePhysicalMemory) / $os.TotalVisibleMemorySize) * 100, 1)
            $uptime        = (Get-Date) - $os.LastBootUpTime
            $uptimeStr     = "{0}d {1}h {2}m" -f $uptime.Days, $uptime.Hours, $uptime.Minutes

            Append-LogText $Log "  System : $cleanVendor $($cs.Model) ($chassisType)`r`n"
            Append-LogText $Log "  OS     : $($os.Caption)`r`n"
            Append-LogText $Log "  RAM    : $ramGb GB total | $ramUsedPct% used`r`n"
            Append-LogText $Log "  CPU    : $cpuLoad% load  |  Uptime: $uptimeStr`r`n`r`n"
        } catch {
            Append-LogText $Log "  (Could not retrieve hardware info: $($_.Exception.Message))`r`n`r`n"
        }

        # --- Pending Reboot ---
        $rebootPending = $false
        if (Test-Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending" -ErrorAction SilentlyContinue) { $rebootPending = $true }
        if (Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired" -ErrorAction SilentlyContinue) { $rebootPending = $true }
        if ($rebootPending) {
            $results.Add([PSCustomObject]@{Component="Pending Reboot"; Status="WARN"; Details="System restart required to finish updates"; Fix="Reboot the PC to apply pending changes."})
        }

        # --- Storage ---
        Get-Volume | Where-Object { $_.DriveLetter -and $_.Size -gt 0 } | ForEach-Object {
            $freePct = [math]::Round(($_.SizeRemaining / $_.Size) * 100, 1)
            if ($freePct -lt 10) {
                $results.Add([PSCustomObject]@{Component="Storage ($($_.DriveLetter):)"; Status="WARN"; Details="Low space ($freePct% free)"; Fix="Clean temp files or move data to another drive."})
            } else {
                $results.Add([PSCustomObject]@{Component="Storage ($($_.DriveLetter):)"; Status="OK"; Details="Healthy ($freePct% free)"; Fix=""})
            }
        }

        # --- Disk SMART ---
        try {
            $smartData = Get-CimInstance -Namespace root\wmi -ClassName MSStorageDriver_FailurePredictStatus -ErrorAction Stop
            foreach ($disk in $smartData) {
                if ($disk.PredictFailure) {
                    $results.Add([PSCustomObject]@{Component="Disk SMART"; Status="FAIL"; Details="Hardware failure predicted!"; Fix="Backup immediately and replace the drive."})
                } else {
                    $results.Add([PSCustomObject]@{Component="Disk SMART"; Status="OK"; Details="Drive health is normal"; Fix=""})
                }
            }
        } catch {
            $results.Add([PSCustomObject]@{Component="Disk SMART"; Status="WARN"; Details="Could not collect SMART data"; Fix="Check WMI service status."})
        }

        # --- Battery (Laptop only — WMI direct, locale-safe) ---
        $chassisCheck = (Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue).PCSystemType
        if ($chassisCheck -eq 2) {
            try {
                $battFull   = Get-CimInstance -Namespace root\wmi -ClassName BatteryFullChargedCapacity -ErrorAction SilentlyContinue
                $battStat   = Get-CimInstance -Namespace root\wmi -ClassName BatteryStaticData          -ErrorAction SilentlyContinue
                $charge     = (Get-CimInstance Win32_Battery -ErrorAction SilentlyContinue)?.EstimatedChargeRemaining
                if (-not $charge) { $charge = "N/A" }

                if ($battFull -and $battStat) {
                    $fullCap   = ($battFull | Measure-Object -Property FullChargedCapacity -Sum).Sum
                    $designCap = ($battStat | Measure-Object -Property DesignedCapacity    -Sum).Sum

                    if ($designCap -gt 0) {
                        $battHealth = [math]::Round(($fullCap / $designCap) * 100, 1)
                        $details    = "Health: $battHealth% (Design: $designCap mWh | Full: $fullCap mWh) | Charge: $charge%"
                        if ($battHealth -lt 60) {
                            $results.Add([PSCustomObject]@{Component="Battery Health"; Status="FAIL"; Details=$details; Fix="Severe degradation — replace the battery."})
                        } elseif ($battHealth -lt 80) {
                            $results.Add([PSCustomObject]@{Component="Battery Health"; Status="WARN"; Details=$details; Fix="Capacity dropping — runtime will be reduced."})
                        } else {
                            $results.Add([PSCustomObject]@{Component="Battery Health"; Status="OK"; Details=$details; Fix=""})
                        }
                    }
                } else {
                    $results.Add([PSCustomObject]@{Component="Battery Health"; Status="WARN"; Details="Could not fetch WMI battery stats | Charge: $charge%"; Fix=""})
                }
            } catch {
                $results.Add([PSCustomObject]@{Component="Battery Health"; Status="WARN"; Details="WMI error fetching battery details"; Fix=""})
            }
        }

        # --- Windows Defender ---
        try {
            $defender = Get-MpComputerStatus -ErrorAction Stop
            if (-not $defender.RealTimeProtectionEnabled) {
                $results.Add([PSCustomObject]@{Component="Windows Defender"; Status="FAIL"; Details="Real-time protection is DISABLED"; Fix="Enable it in Windows Security settings immediately."})
            } else {
                $results.Add([PSCustomObject]@{Component="Windows Defender"; Status="OK"; Details="Protection active | Signature age: $($defender.AntivirusSignatureAge) day(s)"; Fix=""})
            }
        } catch {
            $results.Add([PSCustomObject]@{Component="Windows Defender"; Status="WARN"; Details="Status unavailable"; Fix="Verify Windows Defender service is running."})
        }

        # --- Stopped Auto-Start Services ---
        $stoppedSvcs = @(Get-CimInstance Win32_Service -Filter "StartMode='Auto' AND State<>'Running'" -ErrorAction SilentlyContinue) |
            Where-Object { $_.Name -notmatch "^(gupdate|gupdatem|edgeupdate|edgeupdatem|AdobeARMservice|MozillaMaintenance|AppXSvc|AsusMultiAntennaSvc|brave|Netlogon|sppsvc|StiSvc|Intel.*TPM.*)$" }
        if ($stoppedSvcs.Count -gt 0) {
            foreach ($svc in $stoppedSvcs) {
                $fix = "Restart service manually or reboot the PC."
                if ($svc.Name -eq "wuauserv") { $fix = "Restart Windows Update service or reboot." }
                if ($svc.Name -eq "Spooler")  { $fix = "Restart Print Spooler / clear print jobs." }
                $results.Add([PSCustomObject]@{Component="Service ($($svc.Name))"; Status="FAIL"; Details="Auto-start service is stopped"; Fix=$fix})
            }
        } else {
            $results.Add([PSCustomObject]@{Component="System Services"; Status="OK"; Details="All critical auto-start services running"; Fix=""})
        }

        # --- System Crash Logs (last 48h) ---
        try {
            [array]$rawEvents = Get-WinEvent -FilterHashtable @{LogName="System"; Level=@(1,2); StartTime=(Get-Date).AddDays(-2)} -ErrorAction SilentlyContinue
        } catch { $rawEvents = @() }
        if ($rawEvents.Count -gt 0) {
            $groupedEvents = $rawEvents | Group-Object Id | Sort-Object Count -Descending | Select-Object -First 5
            foreach ($group in $groupedEvents) {
                $ev = $group.Group[0]
                $fix = switch ($ev.Id) {
                    41    { "Unexpected kernel shutdown — check CPU temps, RAM, or PSU." }
                    6008  { "Previous shutdown was unexpected — check for power loss or overheating." }
                    7     { "Bad disk block — run chkdsk /f /r immediately." }
                    11    { "Disk controller error — check NVMe/SATA cables and drivers." }
                    19    { "Processor hardware error — check CPU voltage and overclocking." }
                    55    { "NTFS corruption — run chkdsk /f." }
                    1001  { "BSOD — inspect minidumps and recent hardware/driver changes." }
                    1002  { "Application hang — check resource usage and memory leaks." }
                    5719  { "Netlogon error — check Domain Controller or VPN connection." }
                    7031  { "Service crashed — check dependencies or recent Windows updates." }
                    default { "Search Event ID $($ev.Id) online for specific guidance." }
                }
                $msg = if ($ev.Message) { $ev.Message -replace "`r`n"," " } else { "Critical crash log registered" }
                if ($msg.Length -gt 60) { $msg = $msg.Substring(0,60) + "..." }
                $display = if ($group.Count -gt 1) { "[x$($group.Count)] $msg" } else { $msg }
                $results.Add([PSCustomObject]@{Component="Crash Log (ID $($ev.Id))"; Status="FAIL"; Details=$display; Fix=$fix})
            }
        } else {
            $results.Add([PSCustomObject]@{Component="System Stability"; Status="OK"; Details="No critical crashes in last 48h"; Fix=""})
        }

        # --- Network Adapters ---
        $hasActiveAdapter = $false
        Get-NetAdapter -ErrorAction SilentlyContinue | ForEach-Object {
            if ($_.Status -ne "Up") {
                $results.Add([PSCustomObject]@{Component="Network ($($_.Name))"; Status="WARN"; Details="Adapter disconnected"; Fix="Check cable or re-enable the adapter."})
            } else {
                $hasActiveAdapter = $true
                $ip = (Get-NetIPAddress -InterfaceIndex $_.InterfaceIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue | Select-Object -First 1).IPAddress
                $details = "Connected ($($_.LinkSpeed))" + $(if ($ip) { " | IP: $ip" } else { "" })
                if ($_.PhysicalMediaType -eq "802.3" -and $_.LinkSpeed -eq "100 Mbps") {
                    $results.Add([PSCustomObject]@{Component="Network ($($_.Name))"; Status="WARN"; Details="Capped at 100 Mbps (cable or port issue)"; Fix="Replace LAN cable (Cat5e/6) or check switch port."})
                } else {
                    $results.Add([PSCustomObject]@{Component="Network ($($_.Name))"; Status="OK"; Details=$details; Fix=""})
                }
            }
        }

        # --- Internet & DNS ---
        if ($hasActiveAdapter) {
            $ping = Test-Connection -ComputerName 8.8.8.8 -Count 2 -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($ping) {
                try { $null = [System.Net.Dns]::GetHostAddresses("google.com"); $dnsOk = $true } catch { $dnsOk = $false }
                if ($dnsOk) {
                    $results.Add([PSCustomObject]@{Component="Internet Access"; Status="OK"; Details="Online (Ping: $($ping.ResponseTime)ms, DNS: OK)"; Fix=""})
                } else {
                    $results.Add([PSCustomObject]@{Component="Internet Access"; Status="FAIL"; Details="Ping OK but DNS resolution failed"; Fix="Check DNS settings on adapter or router."})
                }
            } else {
                $results.Add([PSCustomObject]@{Component="Internet Access"; Status="FAIL"; Details="Ping to 8.8.8.8 failed twice"; Fix="Check router, gateway configuration, or ISP status."})
            }
        } else {
            $results.Add([PSCustomObject]@{Component="Internet Access"; Status="FAIL"; Details="No active network adapters found"; Fix="Connect a LAN cable or enable Wi-Fi."})
        }
    }

    return $results
}

function Show-SystemDiagWindow {
    $Log = New-LogWindow "PC Diagnostics Dashboard"
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "                    PC DIAGNOSTICS DASHBOARD`r`n"
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "  Host: $($env:COMPUTERNAME)  |  User: $($env:USERNAME)`r`n"
    Append-LogText $Log "  Mode: $(if ($Global:IsSimulation) { 'SIMULATION (Dry Run)' } else { 'LIVE SCAN' })`r`n"
    Append-LogText $Log "───────────────────────────────────────────────────────────────`r`n`r`n"
    Append-LogText $Log "Scanning system, please wait...`r`n`r`n"

    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $results = Invoke-SystemDiagnostic $Log

    foreach ($res in $results) {
        Write-DiagRow $Log $res.Component $res.Status $res.Details $res.Fix
    }

    $sw.Stop()
    Write-DiagSummary $Log $results ([math]::Round($sw.Elapsed.TotalSeconds, 1))
}
#endregion

#region --- Security Full Diagnostic ---
function Invoke-SecurityDiagnostic($Log) {
    $results = [System.Collections.Generic.List[PSCustomObject]]::new()

    if ($Global:IsSimulation) {
        Append-LogText $Log "  [SIMULATION MODE] Generating sample security data...`r`n`r`n"
        Start-Sleep -Milliseconds 300
        $results.Add([PSCustomObject]@{Component="Antivirus Protection"; Status="OK";   Details="Defender Active | Signature Age: 1 day(s)";               Fix=""})
        $results.Add([PSCustomObject]@{Component="Windows Firewall";     Status="OK";   Details="All profiles (Domain, Private, Public) active";           Fix=""})
        $results.Add([PSCustomObject]@{Component="Drive Encryption (C:)";Status="WARN"; Details="BitLocker not configured on C:";                          Fix="Enable BitLocker in Control Panel to protect data at rest."})
        $results.Add([PSCustomObject]@{Component="User Account Control"; Status="OK";   Details="UAC active and enforced on Secure Desktop";               Fix=""})
        $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="OK";   Details="Authorized Admins: [Administrator]";                      Fix=""})
        $results.Add([PSCustomObject]@{Component="Network Shares";       Status="OK";   Details="No custom/unsecured network shares exposed";              Fix=""})
        $results.Add([PSCustomObject]@{Component="Security Agents";      Status="OK";   Details="No third-party EDR or traffic filters detected";          Fix=""})
        return $results
    }

    # --- Antivirus & Defender ---
    try {
        $defender = Get-MpComputerStatus -ErrorAction SilentlyContinue
        if (-not $defender) {
            $results.Add([PSCustomObject]@{Component="Antivirus Protection"; Status="FAIL"; Details="Unable to query Microsoft Defender status"; Fix="Verify Windows Security service is running."})
        } elseif ($defender.RealTimeProtectionEnabled) {
            $age = $defender.AntivirusSignatureAge
            $details = "Defender Active | Signature Age: $age day(s)"
            if ($age -gt 3) {
                $results.Add([PSCustomObject]@{Component="Antivirus Protection"; Status="WARN"; Details="$details (Signatures Outdated)"; Fix="Run Windows Update or trigger manual Defender update."})
            } else {
                $results.Add([PSCustomObject]@{Component="Antivirus Protection"; Status="OK"; Details=$details; Fix=""})
            }
        } else {
            $results.Add([PSCustomObject]@{Component="Antivirus Protection"; Status="FAIL"; Details="Real-Time Protection is DISABLED"; Fix="Enable Real-Time Protection in Windows Security immediately."})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Antivirus Protection"; Status="FAIL"; Details="Critical error querying AV: $($_.Exception.Message)"; Fix="Check WMI repository or Defender service."})
    }

    # --- Firewall ---
    try {
        $fwProfiles = Get-NetFirewallProfile -ErrorAction SilentlyContinue
        $disabledProfiles = $fwProfiles | Where-Object { $_.Enabled -eq $false }
        if ($disabledProfiles) {
            $pNames = ($disabledProfiles | Select-Object -ExpandProperty Name) -join ", "
            $results.Add([PSCustomObject]@{Component="Windows Firewall"; Status="FAIL"; Details="Disabled profiles: [$pNames]"; Fix="Run: Set-NetFirewallProfile -All -Enabled True"})
        } else {
            $results.Add([PSCustomObject]@{Component="Windows Firewall"; Status="OK"; Details="All profiles (Domain, Private, Public) active"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Windows Firewall"; Status="FAIL"; Details="Failed to query Firewall state"; Fix="Restart Windows Firewall Service (MpsSvc)."})
    }

    # --- BitLocker ---
    try {
        if (Get-Command Get-BitLockerVolume -ErrorAction SilentlyContinue) {
            $bitlocker = Get-BitLockerVolume -MountPoint "C:" -ErrorAction SilentlyContinue
            if (-not $bitlocker) {
                $results.Add([PSCustomObject]@{Component="Drive Encryption (C:)"; Status="WARN"; Details="BitLocker not configured or unsupported"; Fix="Enable BitLocker in Control Panel to protect data at rest."})
            } elseif ($bitlocker.ProtectionStatus -eq "On" -and $bitlocker.VolumeStatus -eq "FullyEncrypted") {
                $results.Add([PSCustomObject]@{Component="Drive Encryption (C:)"; Status="OK"; Details="BitLocker Active | Fully Encrypted ($($bitlocker.EncryptionMethod))"; Fix=""})
            } else {
                $results.Add([PSCustomObject]@{Component="Drive Encryption (C:)"; Status="FAIL"; Details="Protection: $($bitlocker.ProtectionStatus) | Volume: $($bitlocker.VolumeStatus)"; Fix="Resume BitLocker protection or complete the encryption process."})
            }
        } else {
            $results.Add([PSCustomObject]@{Component="Drive Encryption (C:)"; Status="WARN"; Details="BitLocker unsupported on this Windows Edition"; Fix="Consider upgrading to Windows Pro/Enterprise."})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Drive Encryption (C:)"; Status="FAIL"; Details="Error querying BitLocker"; Fix="Ensure TPM is enabled in BIOS and BitLocker services are active."})
    }

    # --- UAC ---
    try {
        $uacPath      = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
        $consentLevel = (Get-ItemProperty -Path $uacPath -Name "ConsentPromptBehaviorAdmin" -ErrorAction SilentlyContinue).ConsentPromptBehaviorAdmin
        $secDesktop   = (Get-ItemProperty -Path $uacPath -Name "PromptOnSecureDesktop" -ErrorAction SilentlyContinue).PromptOnSecureDesktop
        if ($consentLevel -eq 0) {
            $results.Add([PSCustomObject]@{Component="User Account Control"; Status="FAIL"; Details="UAC is completely DISABLED (Silent Elevation)"; Fix="Restore UAC to default to prevent silent malicious execution."})
        } elseif ($secDesktop -eq 0) {
            $results.Add([PSCustomObject]@{Component="User Account Control"; Status="WARN"; Details="UAC active but Secure Desktop is DISABLED"; Fix="Enable Secure Desktop to prevent credential interception."})
        } else {
            $results.Add([PSCustomObject]@{Component="User Account Control"; Status="OK"; Details="UAC active and enforced on Secure Desktop"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="User Account Control"; Status="FAIL"; Details="Failed to read UAC registry settings"; Fix="Check registry permissions on HKLM System Policies."})
    }

    # --- Local Admins ---
    try {
        $adminMembers = Get-LocalGroupMember -Group "Administrators" -ErrorAction SilentlyContinue
        $localAdmins  = $adminMembers | Where-Object { $_.PrincipalSource -eq "Local" }
        $adminList    = ($localAdmins | Select-Object -ExpandProperty Name) -join ", "
        if ($localAdmins.Count -gt 2) {
            $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="WARN"; Details="High count ($($localAdmins.Count) admins): [$adminList]"; Fix="Review and remove unnecessary admin accounts."})
        } else {
            $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="OK"; Details="Authorized Admins: [$adminList]"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Local Administrators"; Status="FAIL"; Details="Unable to audit Administrators group"; Fix="Verify SAM accounts database integrity."})
    }

    # --- Network Shares ---
    try {
        $shares = Get-SmbShare -ErrorAction SilentlyContinue
        $customShares = $shares | Where-Object { $_.Name -notmatch '^(C\$|ADMIN\$|IPC\$)$' }
        if ($customShares) {
            $shareNames = ($customShares | Select-Object -ExpandProperty Name) -join ", "
            $results.Add([PSCustomObject]@{Component="Network Shares"; Status="WARN"; Details="Custom shares active: [$shareNames]"; Fix="Ensure shares are password-protected and not public."})
        } else {
            $results.Add([PSCustomObject]@{Component="Network Shares"; Status="OK"; Details="No custom/unsecured network shares exposed"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Network Shares"; Status="FAIL"; Details="Failed to query SMB shares"; Fix="Check if Server service (LanmanServer) is running."})
    }

    # --- AV & Security Agents via SecurityCenter2 (proper Windows API) ---
    try {
        [array]$avProducts = Get-CimInstance -Namespace root\SecurityCenter2 -ClassName AntivirusProduct -ErrorAction SilentlyContinue
        $proxyReg  = Get-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings" -ErrorAction SilentlyContinue
        $proxyOn   = $proxyReg.ProxyEnable
        $pacFile   = $proxyReg.AutoConfigURL

        if ($avProducts.Count -gt 0) {
            $detected = ($avProducts | Select-Object -ExpandProperty displayName | Select-Object -Unique) -join ", "
            $results.Add([PSCustomObject]@{Component="Security Agents"; Status="OK"; Details="Registered AV/EDR: [$detected]"; Fix=""})
        } elseif ($proxyOn -eq 1 -or -not [string]::IsNullOrEmpty($pacFile)) {
            $proxyInfo = if ($proxyOn -eq 1) { "Local Proxy ($($proxyReg.ProxyServer))" } else { "PAC File enforced" }
            $results.Add([PSCustomObject]@{Component="Security Agents"; Status="WARN"; Details="No AV registered, traffic filter active: $proxyInfo"; Fix="Verify proxy configuration is intentional."})
        } else {
            $results.Add([PSCustomObject]@{Component="Security Agents"; Status="OK"; Details="No third-party AV detected — Windows Defender is active"; Fix=""})
        }
    } catch {
        $results.Add([PSCustomObject]@{Component="Security Agents"; Status="FAIL"; Details="Error querying SecurityCenter2: $($_.Exception.Message)"; Fix="Check WMI repository integrity."})
    }

    return $results
}

