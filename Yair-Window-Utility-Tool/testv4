        $CB.Foreground = $TextMain
        $CB.Margin  = "16,4,4,4"
        $CB.FontSize = 12
        $CB.Cursor  = "Hand"
        $CB.Add_Checked({   $CountLbl.Text = "$(@($AllCheckboxes | Where-Object IsChecked).Count) selected" })
        $CB.Add_Unchecked({ $CountLbl.Text = "$(@($AllCheckboxes | Where-Object IsChecked).Count) selected" })
        $AllCheckboxes += $CB
        $ListPanel.Children.Add($CB)
    }

    $SearchBox.Add_TextChanged({
        $q = $SearchBox.Text.Trim().ToLower()
        foreach ($ctrl in $ListPanel.Children) {
            if ($ctrl -is [System.Windows.Controls.CheckBox]) {
                $match = ($q -eq "" -or $ctrl.Tag.Name.ToLower().Contains($q) -or $ctrl.Tag.ID.ToLower().Contains($q))
                $ctrl.Visibility = if ($match) { "Visible" } else { "Collapsed" }
            }
        }
    })

    $SelAllBtn.Add_Click({ $AllCheckboxes | ForEach-Object { $_.IsChecked = $true } })
    $ClrAllBtn.Add_Click({ $AllCheckboxes | ForEach-Object { $_.IsChecked = $false } })

    $BtnPanel = New-Object System.Windows.Controls.StackPanel
    $BtnPanel.Orientation = "Horizontal"
    $BtnPanel.HorizontalAlignment = "Right"
    $BtnPanel.Margin = "0,14,0,0"
    [System.Windows.Controls.Grid]::SetRow($BtnPanel, 4)
    $Grid.Children.Add($BtnPanel)

    $RunBtn = New-Object System.Windows.Controls.Button
    $RunBtn.Height  = 38
    $RunBtn.Padding = "24,6"
    $RunBtn.Margin  = "0,0,8,0"
    $RunBtn.FontSize = 13
    $RunBtn.Content = if ($Action -eq "Install") { "Execute Install" } else { "Execute Uninstall" }
    if ($Action -eq "Install") {
        Set-BtnStyle $RunBtn 0 70 45 180 255 200
    } else {
        Set-BtnStyle $RunBtn 80 20 20 255 150 150
    }

    $CancelBtn = New-Object System.Windows.Controls.Button
    $CancelBtn.Content  = "Cancel"
    $CancelBtn.Height   = 38
    $CancelBtn.Padding  = "24,6"
    $CancelBtn.FontSize = 13
    Set-BtnStyle $CancelBtn 50 50 50
    $CancelBtn.Add_Click({ $Win.Close() })

    $BtnPanel.Children.Add($RunBtn)
    $BtnPanel.Children.Add($CancelBtn)

    $RunBtn.Add_Click({
        $Selected = @($AllCheckboxes | Where-Object { $_.IsChecked })
        if (-not $Selected) { return }
        $Win.Close()
        Update-UI

        $Log = New-LogWindow "Executing: $Action"
        Append-LogText $Log "Starting $Action operation...`r`n`r`n"

        if ($Global:IsSimulation) {
            foreach ($item in $Selected) {
                Append-LogText $Log "  $($item.Tag.Name) - SIMULATED`r`n"
                Start-Sleep -Milliseconds 200
            }
            Append-LogText $Log "`r`nSimulation Complete`r`n"
            return
        }

        foreach ($item in $Selected) {
            $app = $item.Tag
            Append-LogText $Log "  Processing: $($app.Name)... "

            if ($Action -eq "Install") {
                $null = winget install --id $($app.ID) --exact --silent --accept-package-agreements --accept-source-agreements --disable-interactivity 2>&1
            } else {
                $null = winget uninstall --id $($app.ID) --exact --silent --disable-interactivity 2>&1
            }

            if ($LASTEXITCODE -eq 0) {
                Append-LogText $Log "Done`r`n"
            } else {
                Append-LogText $Log "Failed (Exit Code: $LASTEXITCODE)`r`n"
            }
        }
        Append-LogText $Log "`r`nOperation Complete`r`n"
    })

    $Win.Content = $Grid
    $Win.ShowDialog() | Out-Null
}
