function Show-DebloatWindow {
    $Win = New-Object System.Windows.Window
    $Win.Title  = "System Debloat"
    $Win.Width  = 520
    $Win.Height = 350
    $Win.Background = $BG
    $Win.WindowStartupLocation = "CenterScreen"

    $Stack = New-Object System.Windows.Controls.StackPanel
    $Stack.Margin = "20"

    $TitleBlock = New-Object System.Windows.Controls.TextBlock
    $TitleBlock.Text = "System Debloat Engine"
    $TitleBlock.FontSize = 18
    $TitleBlock.FontWeight = "Bold"
    $TitleBlock.Foreground = $Yellow
    $TitleBlock.HorizontalAlignment = "Center"
    $TitleBlock.Margin = "0,0,0,15"
    $Stack.Children.Add($TitleBlock)

    $Btn1 = New-Object System.Windows.Controls.Button
    $Btn1.Content  = "1. Remove Bloatware Apps (UWP)"
    $Btn1.Height   = 55
    $Btn1.Margin   = "0,6"
    $Btn1.FontSize = 13
    Set-BtnStyle $Btn1 40 40 40 210 210 210
    $Btn1.Add_Click({
        $Log = New-LogWindow "Bloatware Removal"
        Append-LogText $Log "Starting bloatware removal...`r`n`r`n"
        $Bloat = @("BingNews","BingWeather","TikTok","Facebook","Instagram","XboxApp","ZuneMusic","ZuneVideo","WindowsMaps","Clipchamp","DevHome")
        foreach ($app in $Bloat) {
            Append-LogText $Log "  Removing: $app... "
            if ($Global:IsSimulation) {
                Append-LogText $Log "SIMULATED`r`n"
            } else {
                try {
                    Get-AppxPackage -AllUsers -Name "*$app*" -ErrorAction SilentlyContinue | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue
                    Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue | Where-Object DisplayName -match $app | Remove-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue
                    Append-LogText $Log "DONE`r`n"
                } catch {
                    Append-LogText $Log "FAILED`r`n"
                }
            }
        }
        Append-LogText $Log "`r`nOperation Complete`r`n"
    })
    $Stack.Children.Add($Btn1)

    $Btn2 = New-Object System.Windows.Controls.Button
    $Btn2.Content  = "2. Clear Temp & Cache Files"
    $Btn2.Height   = 55
    $Btn2.Margin   = "0,6"
    $Btn2.FontSize = 13
    Set-BtnStyle $Btn2 40 40 40 210 210 210
    $Btn2.Add_Click({
        $Log = New-LogWindow "Clearing Temp Files"
        Append-LogText $Log "Clearing temporary files...`r`n`r`n"
        $Paths = @($env:TEMP, "C:\Windows\Temp", "C:\Windows\Prefetch")
        foreach ($p in $Paths) {
            Append-LogText $Log "  Processing: $p... "
            if ($Global:IsSimulation) {
                Append-LogText $Log "SIMULATED`r`n"
            } else {
                try {
                    if (Test-Path $p) {
                        Get-ChildItem $p -Recurse -Force -ErrorAction SilentlyContinue |
                            Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
                        Append-LogText $Log "CLEARED`r`n"
                    } else {
                        Append-LogText $Log "NOT FOUND`r`n"
                    }
                } catch {
                    Append-LogText $Log "FAILED (Files likely in use)`r`n"
                }
            }
        }
        Append-LogText $Log "`r`nOperation Complete`r`n"
    })
    $Stack.Children.Add($Btn2)

    $Win.Content = $Stack
    $Win.ShowDialog() | Out-Null
}
#endregion

