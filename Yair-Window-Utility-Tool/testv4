#region --- Log Window (Fixed: no more harsh black background) ---
function New-LogWindow([string]$Title) {
    $Win = New-Object System.Windows.Window
    $Win.Title  = $Title
    $Win.Width  = 760
    $Win.Height = 560
    $Win.Background = $BG
    $Win.WindowStartupLocation = "CenterScreen"

    $Grid = New-Object System.Windows.Controls.Grid
    $Grid.Margin = "12"
    $Grid.RowDefinitions.Add((New-Object System.Windows.Controls.RowDefinition -Property @{Height="*"}))
    $Grid.RowDefinitions.Add((New-Object System.Windows.Controls.RowDefinition -Property @{Height="Auto"}))

    $Txt = New-Object System.Windows.Controls.RichTextBox
    $Txt.IsReadOnly  = $true
    $Txt.Background  = $BG2        # Fixed: dark grey theme instead of pure black
    $Txt.Foreground  = $Green
    $Txt.Padding     = "14"
    $Txt.FontFamily  = "Consolas"
    $Txt.FontSize    = 11
    $Txt.VerticalScrollBarVisibility   = "Auto"
    $Txt.HorizontalScrollBarVisibility = "Auto"
    [System.Windows.Controls.Grid]::SetRow($Txt, 0)

    $CloseBtn = New-Object System.Windows.Controls.Button
    $CloseBtn.Content = "Close"
    $CloseBtn.Height  = 35
    $CloseBtn.Margin  = "0,10,0,0"
    Set-BtnStyle $CloseBtn 55 55 55
    $CloseBtn.Add_Click({ $Win.Close() })
    [System.Windows.Controls.Grid]::SetRow($CloseBtn, 1)

    $Grid.Children.Add($Txt) | Out-Null
    $Grid.Children.Add($CloseBtn) | Out-Null
    $Win.Content = $Grid
    $Win.Show()
    Update-UI
    return $Txt
}

# Helper: print a diagnostic result row to the log window
function Write-DiagRow($Log, $Component, $Status, $Details, $Fix) {
    $tag = switch ($Status) {
        "OK"   { "  [OK]  " }
        "WARN" { "  [!!]  " }
        "FAIL" { "  [XX]  " }
        default { "  [--]  " }
    }
    Append-LogText $Log "$tag$($Component.PadRight(27)) $Details`r`n"
    if ($Fix) {
        Append-LogText $Log "          -> Fix: $Fix`r`n"
    }
    Append-LogText $Log "`r`n"
}

# Helper: print a summary bar
function Write-DiagSummary($Log, $Results, $ElapsedSec) {
    $ok   = @($Results | Where-Object { $_.Status -eq "OK"   }).Count
    $warn = @($Results | Where-Object { $_.Status -eq "WARN" }).Count
    $fail = @($Results | Where-Object { $_.Status -eq "FAIL" }).Count
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "  Summary:  [OK] $ok    [!!] $warn Warnings    [XX] $fail Issues`r`n"
    Append-LogText $Log "  Completed in $ElapsedSec seconds.`r`n"
    if ($Global:IsSimulation) {
        Append-LogText $Log "  * Simulation mode was active — no real changes made.`r`n"
    }
}
#endregion

