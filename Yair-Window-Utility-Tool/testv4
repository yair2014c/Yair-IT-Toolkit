#region --- Secure Updates ---
function Show-SecureUpdatesWindow {
    $Log = New-LogWindow "Windows Secure Update Toolkit"
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "              WINDOWS SECURE UPDATE TOOLKIT`r`n"
    Append-LogText $Log "═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "  Host: $($env:COMPUTERNAME)  |  User: $($env:USERNAME)`r`n"
    Append-LogText $Log "  Mode: $(if ($Global:IsSimulation) { 'SIMULATION (Dry Run)' } else { 'LIVE — Will install updates' })`r`n"
    Append-LogText $Log "───────────────────────────────────────────────────────────────`r`n`r`n"

    if ($Global:IsSimulation) {
        Append-LogText $Log "  [SIM] STEP 1: Creating System Restore Point... SIMULATED`r`n`r`n"
        Append-LogText $Log "  [SIM] STEP 2: Scanning for Security & Critical Updates...`r`n`r`n"
        $simUpdates = @("KB5034441 - Windows Security Update", "KB5034763 - Cumulative Update", "KB890830 - Malicious Software Removal Tool")
        foreach ($upd in $simUpdates) {
            Append-LogText $Log "  [+] Found: $upd`r`n"
            Start-Sleep -Milliseconds 200
        }
        Append-LogText $Log "`r`n  [SIM] STEP 3: Download & Install — SIMULATED ($($simUpdates.Count) updates)`r`n"
        Append-LogText $Log "`r`n  [SIM] Recent Hotfixes (last 3):`r`n"
        Append-LogText $Log "  KB5034441  Installed: $(Get-Date -Format 'yyyy-MM-dd')`r`n"
        Append-LogText $Log "`r`n  Simulation Complete — no changes made.`r`n"
        return
    }

    # --- Step 1: System Restore Point ---
    Append-LogText $Log "  [*] STEP 1: Creating System Restore Point...`r`n"
    try {
        if (Get-Command Checkpoint-Computer -ErrorAction SilentlyContinue) {
            Enable-ComputerRestore -Drive "C:\" -ErrorAction SilentlyContinue
            Checkpoint-Computer -Description "YairUtility_BeforeUpdate" -RestorePointType "MODIFY_SETTINGS" -ErrorAction SilentlyContinue
            Append-LogText $Log "  [+] Restore point created successfully.`r`n`r`n"
        } else {
            Append-LogText $Log "  [!] System Restore unsupported on this Windows Edition (Skipping).`r`n`r`n"
        }
    } catch {
        Append-LogText $Log "  [!] Could not create restore point: $($_.Exception.Message)`r`n`r`n"
    }

    # --- Step 2: Scan for Updates ---
    Append-LogText $Log "  [*] STEP 2: Scanning for Security & Critical Updates...`r`n"
    Append-LogText $Log "  [!] NOTE: UI may pause briefly during download and install phases.`r`n`r`n"
    Update-UI
    try {
        $session    = New-Object -ComObject Microsoft.Update.Session
        $searcher   = $session.CreateUpdateSearcher()
        $searchRes  = $searcher.Search("IsInstalled=0 and Type='Software' and IsHidden=0")
        $toInstall  = New-Object -ComObject Microsoft.Update.UpdateColl
        $critTerms  = @("Security", "Critical")

        foreach ($update in $searchRes.Updates) {
            $isCritical = $false
            foreach ($cat in $update.Categories) {
                if ($critTerms -contains $cat.Name) { $isCritical = $true }
            }
            if ($isCritical) {
                Append-LogText $Log "  [+] Found: $($update.Title)`r`n"
                $toInstall.Add($update) | Out-Null
            }
        }
        Update-UI

        if ($toInstall.Count -gt 0) {
            Append-LogText $Log "`r`n  [*] STEP 3: Downloading $($toInstall.Count) update(s)...`r`n"
            $downloader = $session.CreateUpdateDownloader()
            $downloader.Updates = $toInstall
            $downloader.Download() | Out-Null
            Append-LogText $Log "  [+] Download complete.`r`n`r`n"
            Update-UI

            Append-LogText $Log "  [*] STEP 4: Installing updates...`r`n"
            $installer = $session.CreateUpdateInstaller()
            $installer.Updates = $toInstall
            $result = $installer.Install()
            Append-LogText $Log "  [+] Installation complete. Result code: $($result.ResultCode)`r`n"
        } else {
            Append-LogText $Log "  [+] No critical or security updates found. System is up to date.`r`n"
        }
    } catch {
        Append-LogText $Log "  [!] Update scan failed: $($_.Exception.Message)`r`n"
    }

    # --- Verification ---
    Append-LogText $Log "`r`n  [*] VERIFICATION — Recent Hotfixes (last 5):`r`n"
    try {
        Get-HotFix | Sort-Object InstalledOn -Descending | Select-Object -First 5 | ForEach-Object {
            $date = if ($_.InstalledOn) { $_.InstalledOn.ToString("yyyy-MM-dd") } else { "N/A       " }
            Append-LogText $Log "  $($_.HotFixID.PadRight(12)) Installed: $date  $($_.Description)`r`n"
        }
    } catch {
        Append-LogText $Log "  (Could not retrieve hotfix list)`r`n"
    }

    Append-LogText $Log "`r`n═══════════════════════════════════════════════════════════════`r`n"
    Append-LogText $Log "  Process Complete.`r`n"
}
#endregion

