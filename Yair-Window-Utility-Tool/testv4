#region --- Global State ---
$Global:IsSimulation = $false

function Update-UI {
    try {
        $frame = New-Object System.Windows.Threading.DispatcherFrame
        [System.Windows.Threading.Dispatcher]::CurrentDispatcher.BeginInvoke(
            [System.Windows.Threading.DispatcherPriority]::Background,
            [System.Action]{ $frame.Continue = $false }
        ) | Out-Null
        [System.Windows.Threading.Dispatcher]::PushFrame($frame)
    } catch {
        # Fallback if dispatcher is busy or shutting down
    }
}

function Append-LogText($RichTextBox, [string]$Text) {
    if (-not $RichTextBox) { return }
    try {
        $RichTextBox.Dispatcher.Invoke([System.Action]{
            $range = $RichTextBox.Document.ContentEnd
            $range.InsertTextInRun($Text)
            $RichTextBox.ScrollToEnd()
        })
        Update-UI
    } catch {
        # Catch UI-disposed errors if user closes the log window early
    }
}
#endregion

