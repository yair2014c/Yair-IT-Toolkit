    # Search
    $SearchGrid = New-Object System.Windows.Controls.Grid; $SearchGrid.Margin = "0,0,0,8"
    [System.Windows.Controls.Grid]::SetRow($SearchGrid, 1); $Grid.Children.Add($SearchGrid)

