    $SearchHint.Text = "🔍  חיפוש לפי שם..."
    $SearchHint.Foreground = $TextSub; $SearchHint.FontSize = 12
    $SearchHint.Margin = "10,0,0,0"; $SearchHint.VerticalAlignment = "Center"
    $SearchHint.IsHitTestVisible = $false
    $SearchGrid.Children.Add($SearchBox); $SearchGrid.Children.Add($SearchHint)

    # Controls row
    $CtrlPanel = New-Object System.Windows.Controls.StackPanel
    $CtrlPanel.Orientation = "Horizontal"; $CtrlPanel.Margin = "0,0,0,8"
    [System.Windows.Controls.Grid]::SetRow($CtrlPanel, 2); $Grid.Children.Add($CtrlPanel)

