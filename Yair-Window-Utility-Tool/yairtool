    $RunBtn.Content = if ($Action -eq "Install") { "▶  התקן" } else { "🗑  הסר" }
    $RunBtn.Height = 38; $RunBtn.Padding = "22,6"; $RunBtn.Margin = "0,0,8,0"; $RunBtn.FontSize = 13
    if ($Action -eq "Install") { Set-BtnStyle $RunBtn 0 70 45 180 255 200 } else { Set-BtnStyle $RunBtn 80 20 20 255 150 150 }

    $CancelBtn = New-Object System.Windows.Controls.Button
    $CancelBtn.Content = "ביטול"; $CancelBtn.Height = 38; $CancelBtn.Padding = "22,6"; $CancelBtn.FontSize = 13
    Set-BtnStyle $CancelBtn 50 50 50; $CancelBtn.Add_Click({ $Win.Close() })

    $BtnPanel.Children.Add($RunBtn); $BtnPanel.Children.Add($CancelBtn)

    # Run action
    $RunBtn.Add_Click({
        $Selected = @($AllCheckboxes | Where-Object { $_.IsChecked })
        if (-not $Selected) {
            [System.Windows.MessageBox]::Show("לא נבחרה אף תוכנה.","שים לב","OK","Warning") | Out-Null
            return
        }
        $Log = New-LogWindow "$Action תוכנות ($($Selected.Count) פריטים)"
        $Win.Close()
        Write-Log "Starting $Action for: $(($Selected | ForEach-Object { $_.Tag.Name }) -join ', ')"

        Start-BackgroundJob -Variables @{ Log=$Log; Selected=$Selected; Action=$Action } -Script {
            function AL($t) { $Log.Dispatcher.Invoke([Action]{ $Log.AppendText($t); $Log.ScrollToEnd() }) }
            $args_common = @("--exact","--force","--accept-package-agreements","--accept-source-agreements")
            $ok = 0; $fail = 0
            AL "Starting $Action for $($Selected.Count) app(s)...`r`n`r`n"
            foreach ($item in $Selected) {
                $app = $item.Tag
                AL "  [$Action] $($app.Name)...`r`n"
                try {
                    if ($Action -eq "Install") {
                        & winget install --id $app.ID @args_common 2>&1 | Out-Null
                    } else {
                        & winget uninstall --id $app.ID @args_common 2>&1 | Out-Null
                    }
                    if ($LASTEXITCODE -eq 0) { AL "    [✔] הצליח`r`n"; $ok++ }
                    else                      { AL "    [!] ExitCode $LASTEXITCODE`r`n"; $fail++ }
                    Add-Content $LogFile "[$(Get-Date -f HH:mm:ss)] $Action $($app.Name) ExitCode=$LASTEXITCODE" -EA SilentlyContinue
                } catch {
                    AL "    [✘] Error: $_`r`n"; $fail++
                }
            }
            AL "`r`n--- הושלם: $ok הצליחו | $fail נכשלו ---`r`n"
        }
    })

    $Win.Content = $Grid
    $Win.ShowDialog() | Out-Null
}
#endregion

#region --- Main Window ---
function Show-MainWindow {
    $Win = New-Object System.Windows.Window
    $Win.Title  = "Yair Windows Utility v2.0"
    $Win.Width  = 420
    $Win.Height = 580
    $Win.Background = $BG
    $Win.WindowStartupLocation = "CenterScreen"
    $Win.ResizeMode = "CanMinimize"

    $Stack = New-Object System.Windows.Controls.StackPanel
    $Stack.Margin = "24"

    # Header
    $H1 = New-Object System.Windows.Controls.TextBlock
    $H1.Text = "⚙  Yair Utility"
    $H1.FontSize = 26; $H1.FontWeight = "Bold"; $H1.Foreground = $Accent
    $H1.HorizontalAlignment = "Center"; $H1.Margin = "0,0,0,4"
    $Stack.Children.Add($H1)

    $H2 = New-Object System.Windows.Controls.TextBlock
    $H2.Text = "v2.0 — Windows Management Toolkit"
    $H2.FontSize = 11; $H2.Foreground = $TextSub; $H2.HorizontalAlignment = "Center"; $H2.Margin = "0,0,0,4"
    $Stack.Children.Add($H2)

    $H3 = New-Object System.Windows.Controls.TextBlock
    $H3.Text = "Log: $LogFile"
    $H3.FontSize = 10; $H3.Foreground = New-Brush 70 70 70
    $H3.HorizontalAlignment = "Center"; $H3.Margin = "0,0,0,18"
    $Stack.Children.Add($H3)

    $Sep = New-Object System.Windows.Controls.Separator
    $Sep.Background = New-Brush 45 45 45; $Sep.Margin = "0,0,0,14"
    $Stack.Children.Add($Sep)

    $BtnDefs = @(
        @{ Text="📦  התקנת תוכנות";          FR=180;FG=255;FB=200; Action={ Show-SoftwareWindow "Install"   } }
        @{ Text="🗑   הסרת תוכנות";           FR=255;FG=150;FB=150; Action={ Show-SoftwareWindow "Uninstall" } }
        @{ Text="🧹  ניקוי מערכת (Debloat)";  FR=255;FG=215;FB=90;  Action={ Show-DebloatWindow              } }
        @{ Text="🔄  עדכוני Windows";          FR=200;FG=200;FB=255; Action={ Start-Process "ms-settings:windowsupdate-action" } }
        @{ Text="🩺  דיאגנוסטיקה מלאה";       FR=150;FG=220;FB=255; Action={ Invoke-ExternalScript "Diagnostic" } }
        @{ Text="🔍  סניפר אבטחה";            FR=150;FG=220;FB=255; Action={ Invoke-ExternalScript "Sniffer"    } }
        @{ Text="🛡   אודיטור זהויות";         FR=150;FG=220;FB=255; Action={ Invoke-ExternalScript "Auditor"   } }
    )

    foreach ($def in $BtnDefs) {
        $Btn = New-Object System.Windows.Controls.Button
        $Btn.Content  = $def.Text
        $Btn.Height   = 52
        $Btn.Margin   = "0,5"
        $Btn.FontSize = 14
        $Btn.HorizontalContentAlignment = "Left"
        $Btn.Padding  = "16,0"
        Set-BtnStyle $Btn 38 38 38 $def.FR $def.FG $def.FB
        $Btn.Add_Click($def.Action)
        $Stack.Children.Add($Btn)
    }

    $Win.Content = $Stack
    $Win.ShowDialog() | Out-Null
}
#endregion

Write-Log "=== Yair Utility GUI v2.0 started ==="
Show-MainWindow
