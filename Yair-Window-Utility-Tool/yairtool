#region --- Style Helper ---
function Set-BtnStyle {
    param($Btn, [byte]$BR=40,[byte]$BG_=40,[byte]$BB=40, [byte]$FR=220,[byte]$FG_=220,[byte]$FB=220)
    $Btn.Background        = New-Brush $BR $BG_ $BB
    $Btn.Foreground        = New-Brush $FR $FG_ $FB
    $Btn.BorderBrush       = New-Brush 60 60 60
    $Btn.BorderThickness   = "1"
    $Btn.Cursor            = "Hand"
    $Btn.Padding           = "12,8"
}
#endregion

#region --- Run External Script ---
function Invoke-ExternalScript([string]$Keyword) {
    $ScriptDir = if ($PSScriptRoot) { $PSScriptRoot } else { (Get-Location).Path }
    $File = Get-ChildItem -Path $ScriptDir -Filter "*$Keyword*.ps1" -ErrorAction SilentlyContinue | Select-Object -First 1

    if ($File) {
        Write-Log "Launching: $($File.FullName)"
        # מעדיף pwsh (PS7) אם זמין — fall back ל-powershell
        $Shell = if (Get-Command pwsh -ErrorAction SilentlyContinue) { "pwsh" } else { "powershell" }
        Start-Process $Shell -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$($File.FullName)`""
    } else {
        [System.Windows.MessageBox]::Show(
            "לא נמצא סקריפט עם המילה '$Keyword'`nוודא שהקובץ נמצא באותה תיקייה.",
            "קובץ לא נמצא",
            [System.Windows.MessageBoxButton]::OK,
            [System.Windows.MessageBoxImage]::Warning
        ) | Out-Null
        Write-Log "Script not found for keyword: $Keyword" "WARN"
    }
}
#endregion

