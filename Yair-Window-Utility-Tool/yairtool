    $CountLbl.FontSize = 11; $CountLbl.VerticalAlignment = "Center"; $CountLbl.Margin = "14,0,0,0"

    $CtrlPanel.Children.Add($SelAllBtn); $CtrlPanel.Children.Add($ClrAllBtn); $CtrlPanel.Children.Add($CountLbl)

    # List
    $Scroll = New-Object System.Windows.Controls.ScrollViewer
    $Scroll.VerticalScrollBarVisibility = "Auto"; $Scroll.Background = $BG2; $Scroll.Padding = "4"
    [System.Windows.Controls.Grid]::SetRow($Scroll, 3); $Grid.Children.Add($Scroll)

    $ListPanel = New-Object System.Windows.Controls.StackPanel; $Scroll.Content = $ListPanel

    $AllCheckboxes = @()
    $CurrentCat = ""
    foreach ($App in ($SoftwarePackages | Sort-Object Category, Name)) {
        if ($App.Category -ne $CurrentCat) {
            $CatLbl = New-Object System.Windows.Controls.TextBlock
            $CatLbl.Text = $App.Category; $CatLbl.Foreground = $Yellow
            $CatLbl.FontSize = 12; $CatLbl.FontWeight = "Bold"
            $CatLbl.Margin = "4,10,0,4"; $CatLbl.Tag = $App.Category
            $ListPanel.Children.Add($CatLbl)
            $CurrentCat = $App.Category
        }
        $CB = New-Object System.Windows.Controls.CheckBox
        $CB.Content = $App.Name; $CB.Tag = $App
        $CB.Foreground = $TextMain; $CB.Margin = "14,2,4,2"
        $CB.FontSize = 13; $CB.Cursor = "Hand"
        $CB.Add_Checked({   $CountLbl.Text = "$(@($AllCheckboxes | Where-Object IsChecked).Count) נבחרו" })
        $CB.Add_Unchecked({ $CountLbl.Text = "$(@($AllCheckboxes | Where-Object IsChecked).Count) נבחרו" })
        $AllCheckboxes += $CB
        $ListPanel.Children.Add($CB)
    }

    # Search filter
    $SearchBox.Add_TextChanged({
        $q = $SearchBox.Text.Trim().ToLower()
        $SearchHint.Visibility = if ($q) { "Collapsed" } else { "Visible" }
        foreach ($ctrl in $ListPanel.Children) {
            if ($ctrl -is [System.Windows.Controls.CheckBox]) {
                $ctrl.Visibility = if ($q -eq "" -or $ctrl.Tag.Name.ToLower().Contains($q) -or $ctrl.Tag.Category.ToLower().Contains($q)) { "Visible" } else { "Collapsed" }
            } elseif ($ctrl -is [System.Windows.Controls.TextBlock]) {
                $cat = $ctrl.Tag
                $ctrl.Visibility = if ($AllCheckboxes | Where-Object { $_.Tag.Category -eq $cat -and ($q -eq "" -or $_.Tag.Name.ToLower().Contains($q)) }) { "Visible" } else { "Collapsed" }
            }
        }
    })

    $SelAllBtn.Add_Click({ $AllCheckboxes | ForEach-Object { $_.IsChecked = $true } })
    $ClrAllBtn.Add_Click({ $AllCheckboxes | ForEach-Object { $_.IsChecked = $false } })

    # Bottom buttons
    $BtnPanel = New-Object System.Windows.Controls.StackPanel
    $BtnPanel.Orientation = "Horizontal"; $BtnPanel.HorizontalAlignment = "Right"; $BtnPanel.Margin = "0,12,0,0"
    [System.Windows.Controls.Grid]::SetRow($BtnPanel, 4); $Grid.Children.Add($BtnPanel)

