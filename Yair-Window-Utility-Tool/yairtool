#region --- Background Runspace Helper ---
# מריץ ScriptBlock ב-background ומאפשר עדכון UI ב-thread-safe דרך Dispatcher
function Start-BackgroundJob {
    param(
        [scriptblock]$Script,
        [hashtable]$Variables = @{}
    )
    $rs = [runspacefactory]::CreateRunspace()
    $rs.ApartmentState  = "STA"
    $rs.ThreadOptions   = "ReuseThread"
    $rs.Open()

    foreach ($kv in $Variables.GetEnumerator()) {
        $rs.SessionStateProxy.SetVariable($kv.Key, $kv.Value)
    }
    $rs.SessionStateProxy.SetVariable("LogFile", $LogFile)

    $ps = [powershell]::Create().AddScript($Script)
    $ps.Runspace = $rs
    $null = $ps.BeginInvoke()
}
#endregion

#region --- Debloat Window ---
function Show-DebloatWindow {
    $Win = New-Object System.Windows.Window
    $Win.Title  = "ניקוי מתקדם של המערכת"
    $Win.Width  = 400
    $Win.Height = 460
    $Win.Background = $BG
    $Win.WindowStartupLocation = "CenterScreen"
    $Win.ResizeMode = "NoResize"

    $Stack = New-Object System.Windows.Controls.StackPanel
    $Stack.Margin = "22"

    $TitleBlock = New-Object System.Windows.Controls.TextBlock
    $TitleBlock.Text = "🧹 ניקוי מתקדם"
    $TitleBlock.FontSize = 18
    $TitleBlock.FontWeight = "Bold"
    $TitleBlock.Foreground = $Yellow
    $TitleBlock.HorizontalAlignment = "Center"
    $TitleBlock.Margin = "0,0,0,10"
    $Stack.Children.Add($TitleBlock)

    $Warn = New-Object System.Windows.Controls.TextBlock
    $Warn.Text = "⚠  פעולות אלו משנות הגדרות מערכת. המשך רק אם אתה יודע מה אתה עושה."
    $Warn.Foreground = New-Brush 200 140 0
    $Warn.FontSize = 11
    $Warn.TextWrapping = "Wrap"
    $Warn.Margin = "0,0,0,16"
    $Stack.Children.Add($Warn)

    $BtnDefs = @(
        @{
            Label = "1. הסרת אפליקציות Bloatware (24 יעדים)"
            Action = {
                $Log = New-LogWindow "הסרת Bloatware"
                Start-BackgroundJob -Variables @{ Log=$Log } -Script {
                    function AL($t) { $Log.Dispatcher.Invoke([Action]{ $Log.AppendText($t); $Log.ScrollToEnd() }) }
                    $Bloat = @(
                        "BingNews","BingWeather","BingSports","BingFinance",
                        "MicrosoftSolitaireCollection","MicrosoftMahjong","MicrosoftSudoku",
                        "TikTok","Facebook","Instagram","Twitter",
                        "XboxApp","XboxGameOverlay","XboxGamingOverlay","XboxIdentityProvider",
                        "ZuneMusic","ZuneVideo","WindowsFeedbackHub",
                        "Messaging","People","Microsoft3DViewer","GetHelp","WindowsMaps"
                    )
                    $removed = 0
                    foreach ($n in $Bloat) {
                        AL "בודק $n... "
                        $pkg = Get-AppxPackage -Name "*$n*" -ErrorAction SilentlyContinue
                        if ($pkg) {
                            try {
                                $pkg | Remove-AppxPackage -ErrorAction Stop
                                AL "[✔] הוסר`r`n"
                                $removed++
                                Add-Content $LogFile "[$(Get-Date -f HH:mm:ss)] Removed: $($pkg.Name)" -EA SilentlyContinue
                            } catch { AL "[!] שגיאה`r`n" }
                        } else { AL "[–] לא נמצא`r`n" }
                    }
                    AL "`r`n--- הושלם. הוסרו $removed אפליקציות ---`r`n"
                }
            }
        }
        @{
            Label = "2. ניקוי קבצי Temp (User + System + Prefetch)"
            Action = {
                $Log = New-LogWindow "ניקוי Temp"
                $Paths = @($env:TEMP, "C:\Windows\Temp", "C:\Windows\Prefetch")
                Start-BackgroundJob -Variables @{ Log=$Log; Paths=$Paths } -Script {
                    function AL($t) { $Log.Dispatcher.Invoke([Action]{ $Log.AppendText($t); $Log.ScrollToEnd() }) }
                    $totalMB = 0
                    foreach ($p in $Paths) {
                        if (-not (Test-Path $p)) { AL "לא קיים: $p`r`n"; continue }
                        AL "מנקה $p... "
                        $size = (Get-ChildItem $p -Recurse -Force -EA SilentlyContinue | Measure-Object Length -Sum -EA SilentlyContinue).Sum
                        Get-ChildItem $p -Recurse -Force -EA SilentlyContinue | Remove-Item -Recurse -Force -EA SilentlyContinue
                        $mb = [math]::Round($size/1MB, 1)
                        $totalMB += $mb
                        AL "[✔] ~$mb MB שוחרר`r`n"
                    }
                    AL "`r`n--- סה`"כ שוחרר: ~$totalMB MB ---`r`n"
                    Add-Content $LogFile "[$(Get-Date -f HH:mm:ss)] Temp clean: ~$totalMB MB" -EA SilentlyContinue
                }
            }
        }
        @{
            Label = "3. השבתת שירותי Telemetry + Registry"
            Action = {
                $Log = New-LogWindow "השבתת Telemetry"
                Start-BackgroundJob -Variables @{ Log=$Log } -Script {
                    function AL($t) { $Log.Dispatcher.Invoke([Action]{ $Log.AppendText($t); $Log.ScrollToEnd() }) }
                    foreach ($svc in @("DiagTrack","dmwappushservice","PcaSvc")) {
                        try {
                            $s = Get-Service $svc -EA SilentlyContinue
                            if ($s) {
                                Stop-Service $svc -Force -EA SilentlyContinue
                                Set-Service  $svc -StartupType Disabled -EA Stop
                                AL "[✔] הושבת: $svc`r`n"
                            }
                        } catch { AL "[!] לא ניתן: $svc`r`n" }
                    }
                    try {
                        $reg = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"
                        if (-not (Test-Path $reg)) { New-Item $reg -Force | Out-Null }
                        Set-ItemProperty $reg "AllowTelemetry" 0 -Type DWord -Force
                        AL "[✔] Registry: AllowTelemetry = 0`r`n"
                        Add-Content $LogFile "[$(Get-Date -f HH:mm:ss)] Telemetry disabled" -EA SilentlyContinue
                    } catch { AL "[!] שגיאת Registry: $_`r`n" }
                    AL "`r`n--- הושלם ---`r`n"
                }
            }
        }
        @{
            Label = "4. ניקוי DNS Cache"
            Action = {
                $Log = New-LogWindow "ניקוי DNS"
                try {
                    Clear-DnsClientCache -ErrorAction Stop
                    $Log.Dispatcher.Invoke([Action]{ $Log.AppendText("[✔] DNS Cache נוקה`r`n"); $Log.ScrollToEnd() })
                    Write-Log "DNS cache cleared"
                } catch {
                    $Log.Dispatcher.Invoke([Action]{ $Log.AppendText("[!] שגיאה: $_`r`n"); $Log.ScrollToEnd() })
                    Write-Log "DNS flush error: $_" "ERROR"
                }
            }
        }
    )

    foreach ($def in $BtnDefs) {
        $Btn = New-Object System.Windows.Controls.Button
        $Btn.Content = $def.Label
        $Btn.Height = 52
        $Btn.Margin = "0,5"
        $Btn.FontSize = 13
        Set-BtnStyle $Btn 40 40 40 200 200 200
        $Btn.Add_Click($def.Action)
        $Stack.Children.Add($Btn)
    }

    $Win.Content = $Stack
    $Win.ShowDialog() | Out-Null
}
#endregion

