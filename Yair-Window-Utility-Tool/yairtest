        '1' { Invoke-SoftwareManagement -Action "Install" }
        '2' { Invoke-SoftwareManagement -Action "Uninstall" }
        '3' { Invoke-DeepClean }
        '4' { Start-Process "ms-settings:windowsupdate-action" }
        '5' { Invoke-LocalScript -Keyword "Diagnostic" -DefaultName "System-Full-Diagnostic.ps1" }
        '6' { Invoke-LocalScript -Keyword "Sniffer"    -DefaultName "Security-Incident-Sniffer.ps1" }
        '7' { Invoke-LocalScript -Keyword "Auditor"    -DefaultName "Security-Identity-Auditor.ps1" }
        '0' { Write-Log "Utility exited by user"; exit }
        default { Write-Host "`n[!] Invalid option. Try again." -ForegroundColor DarkYellow }
    }
}
#endregion