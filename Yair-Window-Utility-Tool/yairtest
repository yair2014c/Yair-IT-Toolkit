#region --- Install / Uninstall ---
function Invoke-SoftwareManagement {
    param([ValidateSet("Install","Uninstall")][string]$Action)

    if (-not (Assert-Winget)) { Pause; return }

    $Title = "Yair Utility - Select Apps to $Action (Hold CTRL for multiple)"

    # העברה ישירה ל-Out-GridView ללא בניית אובייקטים מחדש
    $SelectedApps = $SoftwarePackages |
        Select-Object Category, Name, Note, ID, Process |
        Out-GridView -Title $Title -PassThru

    if (-not $SelectedApps) {
        Write-Host "`n[i] No apps selected. Returning to menu." -ForegroundColor DarkGray
        return
    }

    Write-Host "`n[*] Starting $Action sequence for $($SelectedApps.Count) app(s)...`n" -ForegroundColor Cyan
    Write-Log "Starting $Action for: $(($SelectedApps.Name) -join ', ')"

    $wingetArgs = @(
        "--exact"
        "--force"
        "--accept-package-agreements"
        "--accept-source-agreements"
    )
    if ($Action -eq "Install") { $wingetArgs += "--include-unknown" }

    $Success = 0
    $Failed  = 0

    foreach ($App in $SelectedApps) {
        Write-Host "  -> [$Action] $($App.Name)..." -ForegroundColor Yellow
        try {
            if ($Action -eq "Uninstall") {
                $proc = Get-Process -Name $App.Process -ErrorAction SilentlyContinue
                if ($proc) {
                    Write-Host "     Closing running process: $($App.Process)" -ForegroundColor DarkYellow
                    $proc | Stop-Process -Force
                    Start-Sleep -Seconds 2
                }
                & winget uninstall --id $App.ID @wingetArgs
            } else {
                & winget install --id $App.ID @wingetArgs
            }

            if ($LASTEXITCODE -eq 0) {
                Write-Host "     [✔] Done." -ForegroundColor Green
                Write-Log "$Action SUCCESS: $($App.Name)"
                $Success++
            } else {
                Write-Host "     [!] Winget returned exit code $LASTEXITCODE" -ForegroundColor DarkYellow
                Write-Log "$Action WARNING: $($App.Name) - ExitCode $LASTEXITCODE" "WARN"
                $Failed++
            }
        } catch {
            Write-Host "     [✘] Error: $_" -ForegroundColor Red
            Write-Log "$Action FAILED: $($App.Name) - $_" "ERROR"
            $Failed++
        }
    }

    Write-Host "`n[+] Sequence complete — Success: $Success | Failed/Skipped: $Failed" -ForegroundColor Green
    Write-Log "$Action complete. Success=$Success Failed=$Failed"
    Pause
}
#endregion

#region --- Deep Clean ---
function Invoke-DeepClean {
    Clear-Host
    Write-Host '==============================================================================' -ForegroundColor Yellow
    Write-Host '                     ADVANCED SYSTEM DEBLOAT AND PURGE                        ' -ForegroundColor Yellow
    Write-Host '==============================================================================' -ForegroundColor Yellow
    Write-Host ''
    Write-Host ' This will perform the following actions:' -ForegroundColor White
    Write-Host '   [1] Remove common bloatware apps' -ForegroundColor Gray
    Write-Host '   [2] Disable Windows telemetry services' -ForegroundColor Gray
    Write-Host '   [3] Clean Temp folders (User + System)' -ForegroundColor Gray
    Write-Host '   [4] Flush DNS cache' -ForegroundColor Gray
    Write-Host ''

    $confirm = Read-Host " Proceed? (Y / N)"
    if ($confirm -notmatch "^[Yy]$") {
        Write-Host "`n[i] Operation cancelled." -ForegroundColor DarkGray
        return
    }

    Write-Log "Deep clean started"

    # 1. הסרת Bloatware
    Write-Host "`n[1/4] Removing bloatware..." -ForegroundColor Cyan
    $Bloatware = @(
        "BingNews", "BingWeather", "BingSports", "BingFinance",
        "MicrosoftSolitaireCollection", "MicrosoftMahjong", "MicrosoftSudoku",
        "TikTok", "Facebook", "Instagram", "Twitter", "Spotify",
        "XboxApp", "XboxGameOverlay", "XboxGamingOverlay", "XboxIdentityProvider",
        "ZuneMusic", "ZuneVideo", "WindowsFeedbackHub",
        "Messaging", "People", "Microsoft3DViewer",
        "GetHelp", "Getstarted", "WindowsMaps"
    )
    $RemovedCount = 0
    foreach ($AppName in $Bloatware) {
        $pkg = Get-AppxPackage -Name "*$AppName*" -ErrorAction SilentlyContinue
        if ($pkg) {
            try {
                $pkg | Remove-AppxPackage -ErrorAction Stop
                Write-Host "   [✔] Removed: $AppName" -ForegroundColor DarkGreen
                Write-Log "Removed bloatware: $AppName"
                $RemovedCount++
            } catch {
                Write-Host "   [!] Could not remove: $AppName" -ForegroundColor DarkYellow
                Write-Log "Could not remove $AppName: $_" "WARN"
            }
        }
    }
    Write-Host "   Removed $RemovedCount app(s)." -ForegroundColor Green

    # 2. השבתת Telemetry
    Write-Host "`n[2/4] Disabling telemetry services..." -ForegroundColor Cyan
    $TelemetryServices = @("DiagTrack", "dmwappushservice", "PcaSvc")
    foreach ($svc in $TelemetryServices) {
        try {
            $s = Get-Service -Name $svc -ErrorAction SilentlyContinue
            if ($s) {
                Stop-Service -Name $svc -Force -ErrorAction SilentlyContinue
                Set-Service  -Name $svc -StartupType Disabled -ErrorAction Stop
                Write-Host "   [✔] Disabled: $svc" -ForegroundColor DarkGreen
                Write-Log "Disabled service: $svc"
            }
        } catch {
            Write-Host "   [!] Could not disable: $svc" -ForegroundColor DarkYellow
            Write-Log "Could not disable $svc: $_" "WARN"
        }
    }

    # ביטול Telemetry ברג'יסטרי
    try {
        $regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"
        if (-not (Test-Path $regPath)) { New-Item -Path $regPath -Force | Out-Null }
        Set-ItemProperty -Path $regPath -Name "AllowTelemetry" -Value 0 -Type DWord -Force
        Write-Host "   [✔] Registry telemetry policy set to 0" -ForegroundColor DarkGreen
        Write-Log "Telemetry registry key set to 0"
    } catch {
        Write-Host "   [!] Could not set registry key: $_" -ForegroundColor DarkYellow
        Write-Log "Registry telemetry error: $_" "WARN"
    }

    # 3. ניקוי Temp
    Write-Host "`n[3/4] Cleaning temp files..." -ForegroundColor Cyan
    $TempPaths = @(
        $env:TEMP,
        "C:\Windows\Temp",
        "C:\Windows\Prefetch"
    )
    $TotalFreed = 0
    foreach ($TempPath in $TempPaths) {
        if (Test-Path $TempPath) {
            try {
                $SizeBefore = (Get-ChildItem $TempPath -Recurse -Force -ErrorAction SilentlyContinue |
                    Measure-Object -Property Length -Sum).Sum
                Get-ChildItem -Path $TempPath -Recurse -Force -ErrorAction SilentlyContinue |
                    Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
                $TotalFreed += $SizeBefore
                Write-Host "   [✔] Cleaned: $TempPath" -ForegroundColor DarkGreen
            } catch {
                Write-Host "   [!] Partial clean: $TempPath" -ForegroundColor DarkYellow
            }
        }
    }
    $FreedMB = [math]::Round($TotalFreed / 1MB, 1)
    Write-Host "   Approximately $FreedMB MB freed." -ForegroundColor Green
    Write-Log "Temp clean complete. ~$FreedMB MB freed"

    # 4. Flush DNS
    Write-Host "`n[4/4] Flushing DNS cache..." -ForegroundColor Cyan
    try {
        Clear-DnsClientCache -ErrorAction Stop
        Write-Host "   [✔] DNS cache flushed." -ForegroundColor DarkGreen
        Write-Log "DNS cache flushed"
    } catch {
        Write-Host "   [!] DNS flush failed: $_" -ForegroundColor DarkYellow
        Write-Log "DNS flush error: $_" "WARN"
    }

    Write-Host "`n[✔] Deep Clean completed successfully!" -ForegroundColor Green
    Write-Log "Deep clean finished"
    Pause
}
#endregion

#region --- Run External Script ---
function Invoke-LocalScript {
    param(
        [string]$Keyword,
        [string]$DefaultName
    )

    $ScriptDir = if ($PSScriptRoot) { $PSScriptRoot } else { (Get-Location).Path }

    $TargetScript = Get-ChildItem -Path $ScriptDir -Filter "*$Keyword*.ps1" -ErrorAction SilentlyContinue |
        Select-Object -First 1

    $ScriptPath = if ($TargetScript) { $TargetScript.FullName } else { Join-Path $ScriptDir $DefaultName }

    if (Test-Path $ScriptPath) {
        Write-Log "Launching script: $ScriptPath"
        try {
            & $ScriptPath   # שימוש ב-& במקום dot-sourcing לבידוד סקופ
        } catch {
            Write-Host "`n[✘] Script error: $_" -ForegroundColor Red
            Write-Log "Script error ($ScriptPath): $_" "ERROR"
            Pause
        }
    } else {
        Write-Host "`n[✘] Script not found: $ScriptPath" -ForegroundColor Red
        Write-Host "    Place the script in the same folder as this utility." -ForegroundColor DarkGray
        Write-Log "Script not found: $ScriptPath" "ERROR"
        Pause
    }
}
#endregion

